<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <h2><%= project.title %></h2>
  <p>Date: <%= project.date %></p>
  <p>Location: <%= project.location %></p>
  <p>Description: <%= project.description %></p>
  <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>

  <h3>Category tags</h3>
  <ul>
    <% categories.forEach(category => { %>
      <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
    <% }) %>
  </ul>

  <% if (user && user.role_name === 'admin') { %>
    <a href="/project/<%= project.project_id %>/assign-categories">Assign Categories</a>
    <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
  <% } %>

  <!-- Volunteer functionality -->
  <% if (user) { %>
    <% if (isVolunteering) { %>
      <p>You are volunteering for this project.</p>
      <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
        <button type="submit">Remove Volunteer</button>
      </form>
    <% } else { %>
      <form action="/project/<%= project.project_id %>/volunteer" method="POST">
        <button type="submit">Volunteer for this Project</button>
      </form>
    <% } %>
  <% } %>
</main>

<%- include('partials/footer') %>
