<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <h2><%= project.title %></h2>
  <p>Date: <%= project.date %></p>
  <p>Location: <%= project.location %></p>
  <p>Description: <%= project.description %></p>
  <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>

  <h3>Category tags</h3>
  <ul>
    <% categories.forEach(category => { %>
      <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
    <% }) %>
  </ul>

  <% if (user && user.role_name === 'admin') { %>
    <a href="/project/<%= project.project_id %>/assign-categories">Assign Categories</a>
    <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
  <% } %>
</main>

<%- include('partials/footer') %>
