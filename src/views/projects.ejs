<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <strong><%= project.date.toDateString() %></strong>
                <a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a>
                (
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
                )
                <br>
                <em><%= project.location %></em> - <%= project.description %>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>



